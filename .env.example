# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# --- Redstring (placeholders only; real values go in .env, which is git-ignored)
# COMPANIES_HOUSE_API_KEY=
# DeepSeek through the framework's OpenAI-compatible engine.
# OPENAI_API_KEY holds a DeepSeek key, obtained at https://platform.deepseek.com/api_keys.
# No OpenAI or Anthropic account is needed. Keep all four together on the Netlify backend.
# The Vercel frontend has no application keys or database credentials.
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
AGENT_ENGINE=ai-sdk:openai
AGENT_MODEL=deepseek-flash
# DATABASE_URL=
# BETTER_AUTH_SECRET=
# AUTH_REQUIRE_EMAIL_VERIFICATION=0
# REDSTRING_SEC_USER_AGENT=
# REDSTRING_KILL_SWITCH=
# REDSTRING_CH_CALLS_PER_USER_DAY=300
# REDSTRING_CH_CALLS_GLOBAL_DAY=2500
# REDSTRING_CASES_PER_USER_DAY=10
# REDSTRING_AGENT_RUNS_PER_USER_DAY=20
# A continuation is the same question carried on (the browser says so, so it is counted too). Default: ten times the run limit.
# REDSTRING_AGENT_CONTINUATIONS_PER_USER_DAY=200
# AGENT_NATIVE_ENABLE_LOCAL_RECURRING_JOBS=1
# CRON_SECRET=
# Optional recording window: all four must be set together. No model key in Vercel.
# REDSTRING_DEMO_OWNER_EMAIL=recording-account@example.com
# REDSTRING_DEMO_BUDGET_ID=recording-session-id
# REDSTRING_DEMO_BUDGET_MICRO_USD=1000000
# REDSTRING_DEMO_EXPIRES_AT=2026-11-07T23:00:00Z
